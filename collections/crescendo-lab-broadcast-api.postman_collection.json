                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"body\": \"<string>\",\n  \"recipients\": [\n    \"<string>\"\n  ],\n  \"name\": \"<string>\",\n  \"scheduled_at\": \"<dateTime>\",\n  \"from\": \"<string>\",\n  \"team\": \"<string>\"\n}",
