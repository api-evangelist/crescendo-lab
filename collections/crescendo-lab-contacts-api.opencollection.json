{
  "opencollection": "1.0.0",
  "info": {
    "name": "MAAC Go Broadcast Contacts API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Contacts",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List contacts",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://sms.cresclab.com/api/contacts",
            "params": [
              {
                "name": "search",
                "value": "",
                "type": "query"
              },
              {
                "name": "tag",
                "value": "",
                "type": "query"
              },
              {
                "name": "page",
                "value": "",
                "type": "query"
              },
              {
                "name": "limit",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "List contacts"
        },
        {
          "info": {
            "name": "Create a contact (single) or bulk",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://sms.cresclab.com/api/contacts",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Single mode: `{ phone, first_name?, last_name?, tags?, consent_source? }`\nBulk mode: `{ contacts: [...], consent_source? }` — up to 10,000 per call.\n\n`consent_source` is required for NCC compliance. Duplicate phones within a batch\nare deduped; existing `(user_id, phone)` pairs are skipped.\n"
        }
      ]
    }
  ],
  "bundled": true
}