          "name": "Create a contact (single) or bulk",
          "request": {
            "name": "Create a contact (single) or bulk",
            "description": {
              "content": "Single mode: `{ phone, first_name?, last_name?, tags?, consent_source? }`\nBulk mode: `{ contacts: [...], consent_source? }` — up to 10,000 per call.\n\n`consent_source` is required for NCC compliance. Duplicate phones within a batch\nare deduped; existing `(user_id, phone)` pairs are skipped.\n",
              "type": "text/plain"
            },
