        {
          "id": "dee71665-dd72-45f1-b178-0dbe38f0d06b",
          "name": "Cost attribution per team (messages / cost / delivered / failed)",
          "request": {
            "name": "Cost attribution per team (messages / cost / delivered / failed)",
            "description": {
              "content": "Returns one row per team plus `(未分類)` for untagged sends, so the rows sum to the\naccount total. Money is shared (one wallet, one invoice per 統編); this is a reporting\nbreakdown for internal chargeback, **not** a wallet split.\n\nWindowing: pass `from`/`to` for an exact billing period (monthly chargeback), or `days`\nfor a rolling window. `from`/`to` take precedence when supplied.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "sms",
                "by-team"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "days",
                  "value": "30",
                  "description": "Rolling window in days (ignored if from/to given)."
                },
                {
                  "disabled": false,
                  "key": "from",
                  "value": "<dateTime>",
                  "description": "Start of an exact range (ISO date/datetime, inclusive)."
                },
                {
                  "disabled": false,
                  "key": "to",
                  "value": "<dateTime>",
                  "description": "End of an exact range (ISO date/datetime, exclusive)."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
          "response": [
